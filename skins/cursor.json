{
  "$schema": "../schemas/skin.schema.json",
  "id": "cursor",
  "name": "Cursor",
  "description": "Cursor in both layouts: the classic editor (VS Code skin plus Cursor's panes) and the agent layout built on Cursor's glass components.",
  "extends": "vscode",
  "match": {
    "urls": ["vscode-file://vscode-app/*/workbench.html*"]
  },
  "scheme": {
    "dark": [".monaco-workbench.vs-dark", ".monaco-workbench.hc-black", "[data-color-bucket=\"dark\"]", "body.cursor-dark"],
    "light": [".monaco-workbench.vs", ".monaco-workbench.hc-light", "[data-color-bucket=\"light\"]", "body.cursor-light"]
  },
  "vars": {
    "scope": [".monaco-workbench", "[data-component=\"root\"]"],
    "values": {
      "--glass-surface-background": "transparent",
      "--glass-chat-surface-background": "transparent",
      "--glass-editor-surface-background": "var(--diorama-glass)",
      "--glass-sidebar-surface-background": "var(--diorama-glass)",
      "--glass-onboard-surface-background": "var(--diorama-glass)",
      "--glass-gallery-sidebar-background": "var(--diorama-glass)",
      "--glass-chat-bubble-background": "var(--diorama-glass-strong)",
      "--cursor-bg-chrome": "transparent",
      "--cursor-bg-editor": "transparent",
      "--cursor-bg-sidebar": "var(--diorama-glass)",
      "--prompt-input-container-bg": "var(--diorama-glass-strong)"
    }
  },
  "slots": [
    { "name": "agents-sidebar", "role": "glass", "selectors": [".monaco-workbench .part.unifiedsidebar"] },
    { "name": "tab-strip", "role": "clear", "selectors": [".monaco-workbench .part.editor .title.tabs"] },
    { "name": "agent-root", "role": "clear", "selectors": ["[data-component=\"root\"]"] },
    { "name": "agent-panel", "role": "clear", "selectors": ["[data-component=\"agent-panel\"]"] },
    { "name": "agent-sidebar", "role": "blur", "selectors": ["[data-component=\"switcher\"]"] },
    { "name": "agent-menubar", "role": "blur", "selectors": ["[data-component=\"glass-in-app-menubar\"]"] },
    { "name": "agent-composer", "role": "blur", "selectors": [".ui-prompt-input__container"] }
  ],
  "status": "draft",
  "verified": [
    { "app": "Cursor (Windows, classic layout, signed out)", "version": "3.23.12", "date": "2026-10-28" },
    { "app": "Cursor (Windows, agent layout)", "version": "3.23.12", "date": "2026-10-29" }
  ]
}
